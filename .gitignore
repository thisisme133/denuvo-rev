```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
.env
.env.local
*.env.*

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Coverage reports
.coverage
coverage/
htmlcov/

# Editor/IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
target/
*.out
*.exe
*.dll
*.so
*.a

# Dependencies
node_modules/
.mypy_cache/
.pytest_cache/
.gradle/
```